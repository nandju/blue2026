# ─── Supabase (backend) ──────────────────────────────────────────────────
# Project Settings → API dans le dashboard Supabase.
# ATTENTION : SUPABASE_SERVICE_ROLE_KEY ne doit JAMAIS être préfixée par
# NEXT_PUBLIC_ (elle contourne toutes les règles de sécurité de la base).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Authentification admin ──────────────────────────────────────────────
# AUTH_SECRET : chaîne aléatoire utilisée pour signer les sessions admin.
# Génère-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Utilisées une seule fois par `npm run seed:admin` pour créer/mettre à jour
# le compte admin dans la base — n'ont pas besoin de rester après usage.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ─── MR BLUE (chatbot IA, Groq / Llama 3.3) ──────────────────────────────
# Clé gratuite sur https://console.groq.com (Sign up → API Keys → Create API Key)
GROQ_API_KEY=

# ─── Spotify (widget "en écoute" sur /about) ─────────────────────────────
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SPOTIFY_CLIENT_SECRET=
NEXT_PUBLIC_SPOTIFY_REFRESH_TOKEN=
