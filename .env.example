# ─── Couche de données ───────────────────────────────────────────────────
# "local"    : fichiers JSON dans data/ + fichiers téléversés dans public/uploads/
#              (valeur par défaut si la variable est absente).
# "supabase" : base Supabase — branchement prévu en phase 7, NE PAS ACTIVER avant.
# Sur Vercel, le disque est en lecture seule : en mode "local", le site public
# s'affiche avec les valeurs par défaut mais les modifications admin sont refusées.
DATA_DRIVER=local

# ─── Authentification admin (compte unique) ──────────────────────────────
# AUTH_SECRET : chaîne aléatoire utilisée pour signer les sessions admin (8 h).
# Génère-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Compte administrateur unique (mode local).
# Génère le hash avec : pnpm hash:password
# IMPORTANT : dans .env.local, chaque "$" du hash doit être échappé en "\$"
# (sinon Next.js le remplace par une chaîne vide). Le script affiche la ligne
# déjà échappée. Sur Vercel, colle le hash brut (sans "\").
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ─── MR BLUE (chatbot IA, Groq) ──────────────────────────────────────────
# Clé gratuite sur https://console.groq.com (Sign up → API Keys → Create API Key)
GROQ_API_KEY=

# ─── Supabase (phase 7 — inutilisé tant que DATA_DRIVER=local) ───────────
# Project Settings → API dans le dashboard Supabase.
# ATTENTION : SUPABASE_SERVICE_ROLE_KEY ne doit JAMAIS être préfixée par
# NEXT_PUBLIC_ (elle contourne toutes les règles de sécurité de la base).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Utilisées une seule fois par `pnpm seed:admin` (mode Supabase uniquement).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
